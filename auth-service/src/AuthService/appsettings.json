{
  "Urls": "http://localhost:5001",
  "ConnectionStrings": {
    "AuthDb": "Data Source=auth.db"
  },

  // Optional escape hatch (R1.2). null = sessions never expire; only logout
  // ends them. Set a number of hours to restore timed expiry.
  "SessionTtlHours": null,

  // Login retry limit (R1.4, optional since R1.5).
  // MaxLoginAttempts: consecutive failures per username before login answers
  //   423 locked. null (or remove the key) turns the whole mechanism off —
  //   nothing is counted, nothing is stored, 423 is never returned.
  // LockoutMinutes: how long the lock holds before it lifts by itself.
  //   Defaults to 15 when MaxLoginAttempts is set and this key is absent.
  // Both must be greater than 0; anything else stops the service at startup
  // rather than being reinterpreted.
  "MaxLoginAttempts": 5,
  "LockoutMinutes": 15,

  "AllowedOrigin": "http://localhost:4200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
