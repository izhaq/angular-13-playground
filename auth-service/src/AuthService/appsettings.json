{
  "Urls": "http://localhost:5001",
  "ConnectionStrings": {
    "AuthDb": "Data Source=auth.db"
  },

  // Optional escape hatch (R1.2). null = sessions never expire; only logout
  // ends them. Set a number of hours to restore timed expiry.
  "SessionTtlHours": null,

  // Login retry limit (R1.4, optional since R1.5).
  // MaxLoginAttempts: consecutive failures per username before login answers
  //   423 locked. null (or remove the key) turns the whole mechanism off —
  //   nothing is counted, nothing is stored, 423 is never returned.
  // LockoutMinutes: how long the lock holds before it lifts by itself.
  //   Defaults to 15 when MaxLoginAttempts is set and this key is absent.
  // Both must be greater than 0; anything else stops the service at startup
  // rather than being reinterpreted.
  "MaxLoginAttempts": 5,
  "LockoutMinutes": 15,

  // Login rate limit (R1.6b), OFF by default — the two station operators are
  // the normal traffic here, and a limiter nobody asked for is just another
  // way to lock them out.
  // The budget is per CONNECTING PEER. Behind the recommended same-host
  //   reverse proxy every request has the same peer, so it becomes ONE global
  //   login budget: whoever spends the window keeps everyone out of the login
  //   page, operators included, without knowing a username. Set it with that
  //   in mind (see LoginRateLimitOptions, and the spec's "Known accepted
  //   risk"). Per-caller budgets behind a proxy would need
  //   UseForwardedHeaders + KnownProxies, which is deliberately not wired.
  // PermitLimit: login attempts one caller may make per window before the
  //   service answers 429. null (or remove the key) means no limiter at all.
  // WindowSeconds: how long a window lasts. Defaults to 60 when PermitLimit
  //   is set and this key is absent.
  // Both must be greater than 0; anything else stops the service at startup.
  // 429 is deliberately NOT part of the client contract — the login page
  // treats it like any other unexpected status.
  "LoginRateLimit": {
    "PermitLimit": null,
    "WindowSeconds": 60
  },

  // Operator endpoints (R1.5b), off by default. Set this to a LOOPBACK
  // address with a port of its own — e.g. "http://127.0.0.1:5051" — and the
  // service binds a second listener there and serves POST /admin/unlock on
  // it. The route never appears on the public port above, and the admin
  // listener is never routed through the reverse proxy. The primary way to
  // release a locked account needs none of this: `AuthService unlock <user>`.
  "AdminUrls": null,

  // Session cookie Secure flag. false (the default) because dev runs on plain
  // HTTP — a Secure cookie is only ever sent over HTTPS, so setting it here
  // would silently log nobody in. Any deployment served over TLS must set
  // this to true so the sid cookie never travels unencrypted.
  "SecureCookies": false,

  "AllowedOrigin": "http://localhost:4200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
